# ==============================================================
# PRISM AI — FREE AI IMAGE GENERATOR SAAS CONFIGURATION
# ==============================================================

# Server Security & Rate Limiting (HMAC token signature)
COOLDOWN_SECRET=your-secure-cooldown-secret-salt-here-min-32-chars

# Internal Admin Monitoring Dashboard Key (access via /admin)
ADMIN_SECRET_KEY=admin123

# --- PROVIDER CONFIGURATION (Legitimate APIs & Quotas) ---

# 1. Cloudflare Workers AI (Official REST API)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_DAILY_NEURONS=10000

# 2. Google Gemini API (Imagen 3)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# 3. Pollinations AI (Community & Free / Auth supported)
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux

# 4. AI Horde (Free Community Distributed Network)
AI_HORDE_API_KEY=0000000000
AI_HORDE_MAX_WAIT_SECONDS=40

# 5. Hugging Face Inference API
HF_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# 6. Fal.ai (Paid Fallback when free providers exhausted)
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell

# 7. Replicate (Paid Fallback)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=black-forest-labs/flux-schnell

# Optional Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
